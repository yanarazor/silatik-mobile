# Map tile server. Defaults to public OpenStreetMap (light use only, no SLA).
# For production, point at a provider with real terms (MapTiler, Stadia,
# Thunderforest, self-hosted). Include the {z}/{x}/{y} template and any API key.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
